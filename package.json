{
  "name": "gas-chat",
  "version": "0.0.0",
  "private": true,
  "description": "Google Chat alerts and messages for Google Apps Script through an incoming webhook.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-chat.git"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "prettier": "gasdev/prettier",
  "gasdev": {
    "loadOrder": [
      "gas-chat.types.ts",
      "gas-chat.constants.ts",
      "gas-chat.format.ts",
      "gas-chat.class.ts"
    ],
    "release": {
      "githubRelease": true
    }
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^22.20.5",
    "eslint": "^10.7.0",
    "gasdev": "github:yorsh-co/gasdev#semver:^3.0.0-beta.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "clean": "rimraf dist",
    "release": "gasdev release",
    "build:format": "npm run check && npm run build && npm run format:dist",
    "build:release": "npm run build:format && npm run release",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:dist": "prettier ./dist --write --ignore-path .prettierignore",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && gasdev check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && echo '✓ TypeScript passed'"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "gaxios": "^7.3.1"
  }
}
